# Kopiere diese Datei nach .env und trage deine Schlüssel ein.
# .env wird nicht committet.

# Google Places API (New) – wird zur Laufzeit in der App verwendet.
# Ohne Key läuft die App mit Mock-Daten.
EXPO_PUBLIC_PLACES_API_KEY=

# OpenStreetMap-Datensatz für Berlin (täglich von der GitHub Action erzeugt).
# Die Web-App setzt ihn beim Build automatisch; für die native App die volle Adresse eintragen,
# z. B. https://robertertl295-cell.github.io/Tablefinder/data/osm-berlin.json
# Leer = OpenStreetMap wird live abgefragt (langsam).
EXPO_PUBLIC_OSM_DATASET_URL=

# KI-Symbolbilder für Lokale ohne Foto (public/placeholders). Die Web-App setzt den Pfad beim
# Build automatisch; für die native App die volle Adresse eintragen, z. B.
# https://robertertl295-cell.github.io/Tablefinder/placeholders. Leer = keine Symbolbilder.
EXPO_PUBLIC_PLACEHOLDER_BASE_URL=

# Google Maps SDK for Android – nur für Android-Builds nötig (iOS nutzt Apple Maps).
GOOGLE_MAPS_ANDROID_API_KEY=
